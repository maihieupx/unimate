# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unimate?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# Optional Google OAuth (button is hidden when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that become ADMIN on registration
ADMIN_EMAILS="owner@unimate.app"

# --- Google Gemini ---
GEMINI_API_KEY=""
# Any Gemini model id your key can access. Set this to the "Hydrogen" model id if you have access to it.
GEMINI_MODEL="gemini-2.5-flash"
